# Copy this file to .env.local and fill in your Supabase project's values.
# Only PUBLISHABLE identifiers belong here — never the service-role key,
# Resend API key, or Groq API key. Those live only in Supabase project
# secrets, used by Edge Functions, never in the frontend.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: set when deploying to https://<user>.github.io/<repo>/
# VITE_BASE_PATH=/circle-missive/
