# Copy to .env.local for `supabase functions serve --env-file supabase/functions/.env.local`,
# and set each of these as a real Supabase project secret before deploying:
#   supabase secrets set RESEND_API_KEY=... RESEND_FROM_ADDRESS=... \
#     RESEND_WEBHOOK_SECRET=... CRON_SECRET=... APP_BASE_URL=...
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided automatically
# by the platform and don't belong here.

# Resend API key (Settings -> API Keys in the Resend dashboard).
RESEND_API_KEY=re_your_resend_api_key

# Must be a mailbox on a domain you've verified with Resend (SPF/DKIM,
# preferably DMARC too) — see implementation_plan.md Section 6.
RESEND_FROM_ADDRESS="Circle Missive <notifications@mail.example.org>"

# Resend dashboard -> Webhooks -> (create one pointing at your deployed
# resend-webhook function URL) -> Signing Secret. Starts with "whsec_".
RESEND_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Any long random value — generate with e.g. `openssl rand -hex 32`.
# Shared between this value and supabase/cron-setup.sql's cron jobs;
# see that file for how it's used.
CRON_SECRET=a-long-random-value

# The deployed frontend's base URL, no trailing slash — used to build
# links in outgoing email (invite links, cycle links, unsubscribe
# links). E.g. https://your-domain.example or
# https://<user>.github.io/circle-missive
APP_BASE_URL=https://your-domain.example
